rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isGroupMember(groupId) {
      return groupId is string
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && (
          uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          || get(/databases/$(database)/documents/groups/$(groupId)).data.creatorUid == uid()
        );
    }

    function isDmParticipant(chatId) {
      return chatId is string
        && exists(/databases/$(database)/documents/dmThreads/$(chatId))
        && uid() in get(/databases/$(database)/documents/dmThreads/$(chatId)).data.participants;
    }

    function canAccessChat(chatId) {
      return isGroupMember(chatId) || isDmParticipant(chatId);
    }

    function canAccessFileData(data) {
      return data.ownerUid == uid()
        || (data.groupId is string && isGroupMember(data.groupId))
        || (data.chatId is string && canAccessChat(data.chatId));
    }

    function canCreateFile(data) {
      return data.ownerUid == uid()
        && data.name is string
        && data.ext is string
        && data.size is int
        && data.category is string
        && data.storagePath is string
        && data.url is string
        && (
          !(data.groupId is string) || isGroupMember(data.groupId)
        )
        && (
          !(data.chatId is string) || canAccessChat(data.chatId)
        );
    }

    // ── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == uid();
      allow delete: if false;
    }

    // ── Groups ──────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if signedIn()
        && (
          uid() in resource.data.memberUids
          || resource.data.creatorUid == uid()
        );
      allow create: if signedIn()
        && request.resource.data.creatorUid == uid()
        && (uid() in request.resource.data.memberUids)
        && request.resource.data.name is string
        && request.resource.data.code is string;
      allow update, delete: if signedIn()
        && (
          uid() in resource.data.memberUids
          || resource.data.creatorUid == uid()
        );
    }

    // ── Group invites ───────────────────────────────────────────────────────
    match /groupInvites/{inviteId} {
      allow read: if signedIn()
        && (
          resource.data.createdByUid == uid()
          || isGroupMember(resource.data.groupId)
          || (resource.data.inviteeUid is string && resource.data.inviteeUid == uid())
        );
      allow create: if signedIn()
        && request.resource.data.createdByUid == uid()
        && isGroupMember(request.resource.data.groupId);
      allow update, delete: if false;
    }

    // ── Events ──────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if signedIn() && (uid() in resource.data.participantUids);

      allow create: if signedIn()
        && request.resource.data.createdByUid == uid()
        && (uid() in request.resource.data.participantUids)
        && request.resource.data.title is string
        && request.resource.data.start is timestamp
        && request.resource.data.end is timestamp;

      allow update: if signedIn()
        && (uid() in resource.data.participantUids)
        && (uid() in request.resource.data.participantUids);

      allow delete: if signedIn() && (uid() in resource.data.participantUids);
    }

    // ── Tasks ───────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if signedIn() && (uid() in resource.data.participantUids);

      allow create: if signedIn()
        && request.resource.data.createdByUid == uid()
        && (uid() in request.resource.data.participantUids)
        && request.resource.data.title is string
        && request.resource.data.status is string
        && request.resource.data.priority is string;

      allow update: if signedIn()
        && (uid() in resource.data.participantUids)
        && (uid() in request.resource.data.participantUids);

      allow delete: if signedIn() && (uid() in resource.data.participantUids);
    }

    // ── Notifications ───────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.toUid == uid();

      allow create: if signedIn()
        && request.resource.data.toUid is string
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.createdAt is timestamp;

      allow delete: if signedIn() && resource.data.toUid == uid();
      allow update: if false;
    }

    // ── Files ───────────────────────────────────────────────────────────────
    match /files/{fileId} {
      allow read: if signedIn() && canAccessFileData(resource.data);
      allow create: if signedIn() && canCreateFile(request.resource.data);
      allow update, delete: if signedIn() && resource.data.ownerUid == uid();
    }

    // ── DM Threads ──────────────────────────────────────────────────────────
    match /dmThreads/{threadId} {
      allow read: if signedIn() && (uid() in resource.data.participants);
      allow create: if signedIn()
        && request.resource.data.participants is list
        && (uid() in request.resource.data.participants);
      allow update: if signedIn() && (uid() in resource.data.participants);
      allow delete: if false;
    }

    // ── Whiteboards ──────────────────────────────────────────────────────────
    match /whiteboards/{boardId} {
      allow read: if signedIn() && (uid() in resource.data.memberUids);
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberUids is list
        && (uid() in request.resource.data.memberUids)
        && request.resource.data.groupId is string
        && isGroupMember(request.resource.data.groupId);
      allow update: if signedIn() && (uid() in resource.data.memberUids);
      allow delete: if signedIn() && resource.data.ownerUid == uid();
    }

    // ── Messages ────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if signedIn() && canAccessChat(resource.data.chatId);
      allow create: if signedIn()
        && request.resource.data.senderUid == uid()
        && canAccessChat(request.resource.data.chatId)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if signedIn() && resource.data.senderUid == uid();
    }
  }
}
