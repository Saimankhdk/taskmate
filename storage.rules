rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Files are stored under uploads/{ownerUid}/...
    match /uploads/{ownerUid}/{allPaths=**} {
      allow write: if signedIn() && ownerUid == uid();
      allow read: if signedIn() && ownerUid == uid();
    }
  }
}
